# "enabled" usa o mock da API (MSW) no navegador; "disabled" usa a API real.
NEXT_PUBLIC_API_MOCKING=enabled

# Prefixo das chamadas de API vistas pelo navegador. Mantenha "/api" para
# usar o proxy do Next (mesma origem: o cookie de refresh funciona sem CORS).
NEXT_PUBLIC_API_BASE_URL=/api

# Só no servidor do Next: para onde /api/* é repassado quando o mock está
# desligado. Ex.: http://localhost:3333
# API_PROXY_TARGET=http://localhost:3333
